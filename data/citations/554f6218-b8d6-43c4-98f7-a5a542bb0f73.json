    {
      "id": "W7213908762",
      "doi": "10.1515/joc-2026-0346",
      "title": "OAM-based multi-beam FSO transmission system for 40 Gbps data rate: performance evaluation across varying atmospheric attenuation zones in India",
      "authors": [
        "Maninder Kaur",
        "Anmol Goyal",
        "Mehtab Singh"
      ],
      "year": 2026,
      "venue": "Journal of Optical Communications",
      "venue_abbr": "J. Opt. Commun.",
      "rank_label": "未匹配 CIE 2023",
      "keywords": [
        "free-space optical communication",
        "orbital angular momentum multiplexing",
        "Laguerre-Gaussian beams",
        "multi-beam transmission",
        "atmospheric attenuation",
        "atmospheric visibility",
        "Kim model",
        "bit error rate",
        "quality factor",
        "eye diagram",
        "transmission range"
      ],
      "url": "https://doi.org/10.1515/joc-2026-0346",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/554f6218-b8d6-43c4-98f7-a5a542bb0f73.html",
      "summary": "摘要报告：用OAM复用满足高容量无线链路需求：40 Gbps OAM-FSO系统采用四个Laguerre–Gaussian模式各载10 Gbps。按印度金奈、焦特布尔、孟买、斯利那加四地2024年印度气象部能见度数据（Kim模型转换为衰减系数）评估：年均衰减金奈1.13、焦特布尔4.696、孟买4.974、斯利那加13.59 dB/km；以log(BER)与Q因子随传输距离作图并分析各城市最大距离眼图。结论：衰减与距离直接影响链路性能（衰减最低的金奈距离最长）；OAM复用可大幅提升FSO容量，可达距离与大气条件密切相关。",
      "summary_basis": "本站解读 · abstract-only"
    },
