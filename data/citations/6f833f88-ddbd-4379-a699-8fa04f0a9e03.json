    {
      "id": "W7235149533",
      "doi": "10.1364/oe.621031",
      "title": "1.55-µm single-photon differential absorption lidar for water vapor measurements",
      "authors": [
        "zhen zhang",
        "Saifen Yu",
        "Haiyun Xia"
      ],
      "year": 2026,
      "venue": "Optics Express",
      "venue_abbr": "OE",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "single-photon LiDAR",
        "differential absorption lidar",
        "1550 nm",
        "water vapor measurement"
      ],
      "url": "https://doi.org/10.1364/oe.621031",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/6f833f88-ddbd-4379-a699-8fa04f0a9e03.html",
      "summary": "研究在1.55 µm光通信波段实验验证了用于大气水汽测量的直接探测差分吸收激光雷达。系统采用以光频梳为基准的稳频方法和超导纳米线单光子探测器，在120 µJ脉冲能量下探测到微弱的大气后向散射，并按距离估计和校正太阳背景、探测器暗计数及掺铒光纤放大器的放大自发辐射。12小时外场实验的时间分辨率为3分钟，距离分辨率为30米。约1公里处的水汽反演结果与独立原位传感器测量值的相关系数为0.91。",
      "summary_basis": "本站解读 · abstract-only"
    },
