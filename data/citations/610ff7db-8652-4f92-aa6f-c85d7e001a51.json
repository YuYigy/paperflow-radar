    {
      "id": "W7214959297",
      "doi": "10.1364/oe.609627",
      "title": "Decoupled equalization of polarization and transmitter IQ skew in digital subcarrier multiplexing systems",
      "authors": [
        "Hong Lin",
        "Jing Zhang",
        "Shaohua Hu",
        "Bo Xu",
        "Kun Qiu"
      ],
      "year": 2026,
      "venue": "Optics Express",
      "venue_abbr": "OE",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "digital subcarrier multiplexing",
        "polarization demultiplexing",
        "laser phase noise",
        "training sequence design",
        "channel estimation",
        "aliasing",
        "coherent optical fiber transmission",
        "16-QAM"
      ],
      "url": "https://doi.org/10.1364/oe.609627",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/610ff7db-8652-4f92-aa6f-c85d7e001a51.html",
      "summary": "研究通过设计训练序列，以严格线性2×2 MIMO进行偏振解复用，再以嵌入锁相环的广义线性2×2 MIMO联合补偿激光相位噪声和发射端IQ偏斜。在由八个12.5-Gbaud子载波组成的100-GBaud偏振复用16-QAM相干光纤传输实验中，3 ps发射端IQ偏斜条件下，相较传统均衡配置获得0.53 dB的Q²因子增益。相较4×4广义线性滤波器，其性能相当，所需实数乘法数量减少26.9%。",
      "summary_basis": "本站解读 · abstract-only"
    },
