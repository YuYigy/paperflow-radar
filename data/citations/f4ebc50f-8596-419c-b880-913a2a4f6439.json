      "id": "W7220396341",
      "doi": "10.48550/arxiv.2610.03338",
      "title": "Sparse Distributed Fiber Optic Sensor Placement in Metropolitan and Datacenter Elastic Optical Networks",
      "authors": [
        "Sleman Mouammar",
        "Ítalo Brasileiro",
        "André C. Drummond"
      ],
      "year": 2026,
      "venue": "arXiv",
      "venue_abbr": "arXiv",
      "rank_label": "不适用期刊等级",
      "keywords": [
        "sensor placement",
        "elastic optical networks",
        "metropolitan optical networks",
        "failure prediction",
        "network fault diagnosis",
        "service downtime",
        "sensor coverage",
        "prediction window"
      ],
      "url": "https://doi.org/10.48550/arxiv.2610.03338",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/f4ebc50f-8596-419c-b880-913a2a4f6439.html",
      "summary": "该预印本通过仿真研究城域和数据中心弹性光网络中分布式光纤传感设备的数量、部署位置及预测时间对故障恢复的影响，评估带宽阻塞率、受故障影响的电路数量和业务停机时间。摘要报告，贪心最短路径覆盖（GSPC）启发式在传感覆盖5%链路时显著减少受影响电路，25%覆盖时的性能增益与全覆盖场景相当。在5%覆盖场景下，城域和数据中心网络分别采用15毫秒和7.5毫秒预测窗口即可支持即时（JIT）恢复。",
      "summary_basis": "本站解读 · abstract+pdf-link"
    },
