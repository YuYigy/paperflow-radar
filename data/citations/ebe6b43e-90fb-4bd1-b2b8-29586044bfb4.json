    {
      "id": "W7215683469",
      "doi": "10.1063/5.0349210",
      "title": "Simultaneous C+L-band nano-ITLA based on co-packaged multi-channel interference lasers for 400G coherent communication",
      "authors": [
        "Zifeng Chen",
        "Quanan Chen",
        "Chun Jiang",
        "Jiajun Lou",
        "Zhida Wang",
        "Xiangxi Zeng",
        "Yuanhao Zhang",
        "Qiaoyin Lu",
        "Weihua Guo"
      ],
      "year": 2026,
      "venue": "APL Photonics",
      "venue_abbr": "APL Photonics",
      "rank_label": "CIE T1 · 2023",
      "keywords": [
        "co-packaging",
        "semiconductor optical amplifier",
        "thermoelectric cooling",
        "printed circuit board integration",
        "side-mode suppression ratio",
        "narrow linewidth"
      ],
      "url": "https://doi.org/10.1063/5.0349210",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/ebe6b43e-90fb-4bd1-b2b8-29586044bfb4.html",
      "summary": "摘要报告将覆盖C++与L++波段的两枚激光芯片及辅助部件共封装为nano-ITLA，尺寸为25.0×15.6×6.5毫米。器件支持C+L波段240个间隔50 GHz的ITU频点，边模抑制比大于45 dB、输出功率大于16.5 dBm、洛伦兹线宽小于180 kHz。集成至CFP-2相干光模块后，在400 Gbit/s传输中保持前向纠错前误码率低于4×10⁻³。",
      "summary_basis": "本站解读 · abstract-only"
    },
