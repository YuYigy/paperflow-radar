    {
      "id": "W7212245888",
      "doi": "10.1364/oe.610358",
      "title": "Gated joint source-channel coding for turbulence-resilient semantic transmission over underwater wireless optical channels",
      "authors": [
        "Yan Ge",
        "Zhitong Huang",
        "Jie Xu",
        "Yi Gao",
        "qiming Gao"
      ],
      "year": 2026,
      "venue": "Optics Express",
      "venue_abbr": "OE",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "underwater optical communication",
        "joint source-channel coding",
        "ocean turbulence",
        "vision transformer",
        "depthwise convolution",
        "spatially correlated fading",
        "image transmission"
      ],
      "url": "https://doi.org/10.1364/oe.610358",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/240763da-c834-4521-b7b8-22ede041df2b.html",
      "summary": "摘要报告：UWOC带宽受限使传统分离式信源-信道编码处理高维图像效率低下；现有UWOSC在海洋湍流下性能显著退化。提出gated-JSCC：在ViT-JSCC上引入双端注意力输出门控（把深度衰减token的影响限制在注意力输出内）与深度卷积增强前馈网络（增强空间相关衰落下的局部空间一致性）。仿真覆盖宽SNR、湍流强度与传播距离：较ViT-JSCC基线获得约1.1–1.7 dB一致PSNR增益；同符号预算实验中，在湍流相关的气泡和温度衰落下较传统分离编码优6.1–14.4 dB。",
      "summary_basis": "本站解读 · abstract-only"
    },
