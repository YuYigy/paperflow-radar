    {
      "id": "W7225248305",
      "doi": "10.3390/photonics13111046",
      "title": "Enhancing Secrecy Rates in Indoor Visible Light Communication via Spatially Confined Data Transmission and Artificial Noise Under Multipath Reflections",
      "authors": [
        "Mijoo Park",
        "Hyunchae Chun"
      ],
      "year": 2026,
      "venue": "Photonics",
      "venue_abbr": "Photonics",
      "rank_label": "未匹配 CIE 2023",
      "keywords": [
        "visible light communication",
        "physical layer security",
        "secrecy rate",
        "artificial noise",
        "multipath reflections",
        "Gaussian wiretap channel",
        "secrecy capacity",
        "indoor lighting"
      ],
      "url": "https://doi.org/10.3390/photonics13111046",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/78f0d234-9a1d-47f3-b568-ceaa80b7d01a.html",
      "summary": "研究基于幅度受限高斯窃听信道模型和保密容量下界，比较三种灯具布局下的单输入单输出广播、空间限域数据传输及其结合人工噪声的方案，并纳入截至三阶的漫反射。在包含反射、半功率半角为20°的最优接收位置，四簇布局的平均保密速率由广播方案的2.10提升至两种方案的5.36和5.68 bit/信道使用。摘要报告，反射降低了各位置的广播保密速率，而空间限域传输的速率基本保持不变，叠加人工噪声可进一步改善。",
      "summary_basis": "本站解读 · abstract-only"
    },
