    {
      "id": "W7172382335",
      "doi": "10.1364/jocn.601174",
      "title": "Multi-granularity collaborative scheduling method for distributed AI training in all-optical data center networks",
      "authors": [
        "Huitao Zhou",
        "Haoyang Chen",
        "Bojun Zhang",
        "Yuanhang Shi",
        "Zhiqun Gu",
        "Jiawei Zhang",
        "Yuefeng Ji"
      ],
      "year": 2026,
      "venue": "Journal of Optical Communications and Networking",
      "venue_abbr": "JOCN",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "optical circuit switching",
        "mixed-integer linear programming",
        "heuristic scheduling algorithm",
        "combinatorial optimization"
      ],
      "url": "https://doi.org/10.1364/jocn.601174",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/5301d154-cd6b-4d95-aa30-dc22c9a5f24a.html",
      "summary": "摘要报告：AI数据中心分布式训练产生多作业并发的大规模通信需求，全光交换网络是高带宽低时延方案，但需求多样引发资源争用。提出多粒度协同调度（MGCS）：融合光时隙交换（OTS）与光路交换（OCS），按阶段感知分层调度——对流水线并行（PP）通信，将确定性OTS调度形式化为组合优化并给出MILP模型与启发式算法；对数据并行（DP）通信采用动态协调OTS与OCS的混合多粒度调度。搭建小规模全光交换试验床并开展大规模仿真：MGCS最多降低epoch训练时间30.60%、网络资源占用比49.70%。",
      "summary_basis": "本站解读 · abstract-only"
    },
