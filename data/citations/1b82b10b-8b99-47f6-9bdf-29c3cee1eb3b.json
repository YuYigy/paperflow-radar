    {
      "id": "W7220904116",
      "doi": "10.1364/ol.612078",
      "title": "Continuous QPSK-OFDM for integrated optical communication and distributed acoustic sensing",
      "authors": [
        "Xi CHEN",
        "Maoqi Liu",
        "Yichang Wu",
        "Zixian Wei",
        "Changyuan Yu",
        "Zhaohui Li"
      ],
      "year": 2026,
      "venue": "Optics Letters",
      "venue_abbr": "OL",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "optical frequency division multiplexing",
        "distributed acoustic sensing",
        "optical OFDM"
      ],
      "url": "https://doi.org/10.1364/ol.612078",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/1b82b10b-8b99-47f6-9bdf-29c3cee1eb3b.html",
      "summary": "摘要报告以单一连续QPSK-OFDM波形同时支持光通信与瑞利后向散射传感，无需传感突发、零填充或独立波长、时间资源，但循环前缀时长必须超过光纤往返时延。偏振合并和子带合并分别抑制偏振衰落与瑞利衰落。在5.9 km光纤上，空间分辨率为2.50 m，传感采样率为7.915 kHz；前向传输速率为208.95 Mb/s，未观察到比特错误，RMS EVM为−27.00 dB。",
      "summary_basis": "本站解读 · abstract-only"
    },
