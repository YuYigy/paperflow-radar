      "id": "W7225581985",
      "doi": "10.1364/oe.614242",
      "title": "RF Pilot-Aided Photonics-Assisted THz Wireless Transmission with Enhanced Laser Linewidth Tolerance",
      "authors": [
        "Xiongwei Yang",
        "Junwei Li",
        "Lin Zou",
        "Jingtian Liu",
        "yi wei",
        "Feng Zhao",
        "Jingling Li",
