    {
      "id": "W7203829757",
      "doi": "10.1364/ol.606921",
      "title": "Externally time-gated photon-counting OTDR in the 1.5 µm telecom band",
      "authors": [
        "Ri-Yao Song",
        "Yunru Fan",
        "Peng Wu",
        "Yao Xiao",
        "Qi Zhang",
        "Hai-Zhi Song",
        "Bin Li",
        "Tao Zhou",
        "Yanan Wang",
        "Kai Guo",
        "Guang‐Can Guo",
        "Qiang Zhou"
      ],
      "year": 2026,
      "venue": "Optics Letters",
      "venue_abbr": "OL",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "optical time-domain reflectometry",
        "dynamic range"
      ],
      "url": "https://doi.org/10.1364/ol.606921",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/bd334002-bc3c-48dd-9447-f7bf89f48138.html",
      "summary": "摘要报告：光子计数OTDR的动态范围受单光子探测器死时间与最大计数率限制。演示工作于1.5 µm电信波段的外部时间门控PC-OTDR：用光调制器门控后向传播信号，仅让特定光纤段的光子到达探测器，从而抑制门外背散光子并优化有限计数率利用。结果：0.36 dB弱损耗事件被清晰分辨（无门控时不可见）；50 ns外门控下70 m系统动态范围24.1 dB，较无门控提升10.8 dB。",
      "summary_basis": "本站解读 · abstract-only"
    },
