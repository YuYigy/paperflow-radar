    {
      "id": "W7221036337",
      "doi": "10.1364/ol.612605",
      "title": "Bidirectional coherent PON over 25-km hollow-core fiber with a laser-free ONU using silicon photonic coherent receivers",
      "authors": [
        "Yutong Pan",
        "张天泓 Zhang Tianhong",
        "Yixiao Zhu",
        "Shikui Shen",
        "Yu Qin",
        "Wenhao Wang",
        "Shuailuo Huang",
        "Limin Xiao",
        "Yichun Shen",
        "ning zhang",
        "Zelin Wang",
        "Fan Zhang"
      ],
      "year": 2026,
      "venue": "Optics Letters",
      "venue_abbr": "OL",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "passive optical networks",
        "hollow-core fiber"
      ],
      "url": "https://doi.org/10.1364/ol.612605",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/9efdc253-a935-4cf4-9563-4c42b10c421d.html",
      "summary": "该研究实验演示了采用无激光器ONU和封装硅光集成相干接收机的双向相干PON，在25公里空芯光纤上实现每方向240 Gb/s毛速率传输。OLT下发的光载波同时用作下行本振和上行调制载波。双向同时传输采用30 GBaud双偏振16-QAM；在15%软判决前向纠错门限下，上行和下行功率预算分别为46.5和45.4 dB。实验还验证了QPSK至64-QAM的灵活运行，对应120至360 Gb/s毛速率。",
      "summary_basis": "本站解读 · abstract-only"
    },
