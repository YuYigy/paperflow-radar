    {
      "id": "W7237357231",
      "doi": "10.1515/joc-2026-0512",
      "title": "Dual-polarization NRZ-based underwater optical wireless communication: range assessment for different water types and receiver aperture diameters",
      "authors": [
        "Amarjeet Kaur",
        "Anmol Goyal",
        "Mehtab Singh"
      ],
      "year": 2026,
      "venue": "Journal of Optical Communications",
      "venue_abbr": "J. Opt. Commun.",
      "rank_label": "未匹配 CIE 2023",
      "keywords": [],
      "url": "https://doi.org/10.1515/joc-2026-0512",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/f442ef20-3bcb-4e0c-8d18-fa656cc8deda.html",
      "summary": "研究对 532 nm 双偏振 NRZ 水下无线光通信链路进行建模，每个偏振通道承载 10 Gbps，总速率为 20 Gbps。研究以 Q ≥ 4 dB 和 log(BER) ≤ −4 为可靠传输判据，评估五类水体和 16、18、20 cm 三种接收孔径。在纯海水中，接收孔径从 16 cm 增至 20 cm 时，模型给出的最大距离由 130 m 增至 140 m。在 Harbor II 水体中，最大距离由 5.45 m 增至 5.65 m。摘要报告各工况在各自的最大距离处眼图均保持张开。",
      "summary_basis": "本站解读 · abstract-only"
    },
