      "doi": "10.1364/oe.613485",
      "title": "Advanced equalizer for 800-Gb/s DP-16QAM coherent transmission systems",
      "authors": [
        "Xuecheng Ren",
        "Jing Zhang",
        "Shen Wang",
        "Rui Wang",
        "Zhaopeng Xu",
