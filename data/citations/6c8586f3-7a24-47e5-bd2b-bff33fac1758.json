      "doi": "10.1364/ol.605060",
      "title": "Low-complexity subcarrier-grouping scheme for adaptive resource allocation in multi-user OFDM-NOMA VLC systems",
      "authors": [
        "Geyang Wang",
        "Chengju Hu",
        "Lian-Kuan Chen",
        "Jian Zhao"
      ],
      "year": 2026,
      "venue": "Optics Letters",
      "venue_abbr": "OL",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "visible light communication",
