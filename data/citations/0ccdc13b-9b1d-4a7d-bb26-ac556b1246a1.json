    {
      "id": "W7220973813",
      "doi": "10.1364/jocn.605818",
      "title": "Photonic gateway architecture extension for port-agnostic accommodation of dual-fiber and single-fiber user terminals in metro/access converged all-photonics network",
      "authors": [
        "Shin Kaneko",
        "Ritsuki Hamagami",
        "Jun‐ichi Kani",
        "Tatsuya Shimada"
      ],
      "year": 2026,
      "venue": "Journal of Optical Communications and Networking",
      "venue_abbr": "JOCN",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "metro-access networks",
        "network convergence",
        "optical access networks"
      ],
      "url": "https://doi.org/10.1364/jocn.605818",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/0ccdc13b-9b1d-4a7d-bb26-ac556b1246a1.html",
      "summary": "论文面向城域与接入融合的全光网络，扩展光子网关架构，使双纤终端与单纤双向终端可在无需预先分配接入端口的情况下完成初始连接。方案通过通用接入端口实现带内远程终端控制，并由网络控制器自适应管理接入端口配对。作者使用网关原型和三类终端进行实验，包括 O 波段 25 Gb/s 双纤 IM-DD 终端、C 波段 100 Gb/s 双纤相干 DWDM 终端及 O 波段 25 Gb/s 单纤双向 IM-DD 终端。摘要报告，三类终端均实现了不依赖预先端口分配的初始接入和后续光路自动建立。",
      "summary_basis": "本站解读 · abstract-only"
    },
