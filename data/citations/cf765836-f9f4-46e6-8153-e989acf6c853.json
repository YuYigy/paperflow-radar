      "doi": "10.48550/arxiv.2610.40904",
      "title": "Optical Quantum Memory Processing for Quantum Hashing",
      "authors": [
        "S. A. Moiseev",
        "M. M. Minnegaliev"
      ],
      "year": 2026,
      "venue": "arXiv",
