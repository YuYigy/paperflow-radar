    {
      "id": "W7220967939",
      "doi": "10.1364/jocn.596279",
      "title": "Programmable filterless architectures for low-cost OTN-over-WDM metro networks",
      "authors": [
        "Aryanaz Attarpour",
        "Ehsan Etezadi",
        "Mëmëdhe Ibrahimi",
        "Francesco Musumeci",
        "A. Castoldi",
