    {
      "id": "W7212193935",
      "doi": "10.1364/jocn.608583",
      "title": "Simultaneous state of polarization sensing on separate ONUs in PON upstream transmission",
      "authors": [
        "Saverio Pellegrini",
        "Laura Greborio",
        "Giuseppe Rizzelli",
        "Valter Ferrero",
        "A. Pagano",
        "Roberto Gaudino"
      ],
      "year": 2026,
      "venue": "Journal of Optical Communications and Networking",
      "venue_abbr": "JOCN",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "optical network unit",
        "passive optical networks",
        "upstream transmission",
        "simultaneous measurement",
        "polarization monitoring"
      ],
      "url": "https://doi.org/10.1364/jocn.608583",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/61473680-b1e1-4ad7-9acb-3b7bb07db281.html",
      "summary": "研究提出在OLT接收机旁并联单台偏振仪，利用GPON上行固有的TDMA突发传输，对多个活跃ONU进行同时偏振态感知。作者采用商用GPON OLT和ONU硬件开展实验，展示了区分馈线与特定配线光纤异常振动的能力，实现粗粒度事件定位。研究还讨论采样率与同步要求，通过对同一ONU突发对应的斯托克斯矢量样本进行平均来改善估计，并实验表征低平均接收功率下的感知限制，以及异构流量下的偏振噪声、估计精度和馈线机械振动信噪比。",
      "summary_basis": "本站解读 · abstract-only"
    },
