    {
      "id": "W7221015723",
      "doi": "10.1364/ol.614071",
      "title": "Low-parasitic-resistance and fabrication-tolerant silicon microring modulators operating beyond 100 GHz",
      "authors": [
        "Yuxiang YIN",
        "Kaihang Lu",
        "Hao Chen",
        "Baohua Wen",
        "Xianyi Feng",
        "Yihao Jian",
        "Xuting Fan",
        "King Hung Chiu",
        "Yeyu Tong"
      ],
      "year": 2026,
      "venue": "Optics Letters",
      "venue_abbr": "OL",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "silicon microring resonator",
        "optical modulators",
        "parasitic resistance",
        "high-frequency operation",
        "terahertz modulation",
        "manufacturing tolerances",
        "integrated photonics"
      ],
      "url": "https://doi.org/10.1364/ol.614071",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/704ec092-d96e-4661-8f6f-0f67041ca3aa.html",
      "summary": "该研究提出结合绝热过渡与加宽低寄生电阻区域的载流子耗尽型硅微环调制器。低电阻截面覆盖腔周长的61%，结串联电阻为36.9 Ω，较传统设计降低35.9%；八个裸片的谐振波长离散范围由3.58 nm降至1.07 nm。摘要报告，在−1至−5 V偏置下，实测3 dB电光带宽超过100 GHz；器件支持144 Gbps NRZ和224 Gbps PAM-4，后者误码率低于7%硬判决前向纠错门限。零偏置自偏置模式实现128 Gbps NRZ，估算能耗为0.861 fJ/bit；耗尽模式能耗为8.878 fJ/bit。",
      "summary_basis": "本站解读 · abstract-only"
    },
