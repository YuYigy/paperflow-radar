    {
      "id": "W7220707492",
      "doi": "10.1364/oe.611650",
      "title": "Asymmetric laser gating for robust low power half-duplex optical link in camera-on-tip surgical endoscopes",
      "authors": [
        "Asif Khan",
        "Valentina Rajkumari",
        "Meena Baskaran",
        "Owen Moynihan",
        "Cleitus Antony",
        "James R. O'Callaghan",
        "Brendan J. Roycroft",
        "Kevin Thomas",
        "E. Pelucchi",
        "Sanathana Konugolu Venkata Sekar",
        "Stefan Andersson‐Engels",
        "Paul D. Townsend",
        "Brian Corbett"
      ],
      "year": 2026,
      "venue": "Optics Express",
      "venue_abbr": "OE",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "cardiovascular imaging",
        "hyperspectral imaging",
        "Fabry-Perot cavity",
        "optical isolation",
        "bending loss"
      ],
      "url": "https://doi.org/10.1364/oe.611650",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/255262c8-4cc3-4228-a4f2-3cfb8d70b577.html",
      "summary": "该研究面向手术内窥镜末端的光通信链路，设计并制造了优化法布里–珀罗腔的表面法向电吸收调制器（SNEAM）。器件在3 V峰峰值驱动下实现约10 dB消光比，工作偏置低于3 V，末端器件功耗约1 mW。研究提出并实验验证非对称门控：仅对下行激光门控，上行激光持续工作。在下行至上行光隔离为0 dB时，实验验证下行误码率低于10⁻⁹。摘要报告该策略提升了链路对变化弯曲损耗的鲁棒性，下行时隙内额外静态功耗约0.2 mW。",
      "summary_basis": "本站解读 · abstract-only"
    },
