    {
      "id": "W7141042569",
      "doi": "10.3390/photonics13111057",
      "title": "Security-Enhanced 16QAM-OFDM Scheme via 3D Hexagonal Shaping and 4D Hyperchaotic Encryption",
      "authors": [
        "Yujia Fu",
        "Dongfei Wang",
        "Baoju Liu",
        "Xiaokun Yang",
        "Zichen Li"
      ],
      "year": 2026,
      "venue": "Photonics",
      "venue_abbr": "Photonics",
      "rank_label": "未匹配 CIE 2023",
      "keywords": [
        "physical layer security",
        "dynamic key generation",
        "minimum Euclidean distance",
        "figure of merit",
        "eavesdropping resistance",
        "long-haul optical transmission",
        "bit error rate"
      ],
      "url": "https://doi.org/10.3390/photonics13111057",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/cac9fc4e-248d-4f22-a701-d80e3a30f925.html",
      "summary": "该研究提出结合三维几何整形与四维超混沌相位加密的相干光OFDM方案，并通过HKDF派生逐帧初态偏移。80 km标准单模光纤数值评估显示，在误码率10⁻⁴下，相比3D-Cube-16，接收灵敏度改善约0.7 dB。计入所评估帧开销后，净荷速率为59.58 Gb/s，净荷频谱效率为1.986 bit/s/Hz。所测试密钥搜索及同帧已知明文攻击在未知后缀上的误码率均约为0.41，但基于幅度的MAP检测可将第一标签位误码率降至约0.02，表明幅度保留导致显著标签信息泄漏。",
      "summary_basis": "本站解读 · abstract-only"
    },
