    {
      "id": "W7220903471",
      "doi": "10.1364/ol.611509",
      "title": "Real-Time UWOC-RF System with Light Source Tracking",
      "authors": [
        "Zhuo Feng",
        "Junjie Li",
        "Wendong Liao",
        "Xiong Qian",
        "Jing Xu"
      ],
      "year": 2026,
      "venue": "Optics Letters",
      "venue_abbr": "OL",
      "rank_label": "CIE T2 · 2023",
      "keywords": [
        "underwater optical communication",
        "RF transmission",
        "light source tracking",
        "real-time communication"
      ],
      "url": "https://doi.org/10.1364/ol.611509",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/da9472b5-67f6-4293-aef1-487fc6bc2e94.html",
      "summary": "该实验研究提出连接水下遥控航行器与无人水面艇的实时UWOC-RF系统，结合视觉跟踪和FPGA信号处理。摘要报告，在衰减系数为1.75 dB/m的现场实验中实现20 Mbps数据率；水面艇自主跟随移动水下航行器时，大部分航行期间误码率低于10⁻⁵，并传输实时视频；在5.5 m传输距离下，误码率低于10⁻³。",
      "summary_basis": "本站解读 · abstract-only"
    },
