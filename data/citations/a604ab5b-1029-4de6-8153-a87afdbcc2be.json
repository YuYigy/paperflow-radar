    {
      "id": "W7225310909",
      "doi": "10.3390/photonics13111048",
      "title": "High-Precision Lumped-Parameter Thermal Modeling and CNN-LSTM-Based Temperature Prediction for Optical Interconnect Modules",
      "authors": [
        "Tianxiang Lan",
        "Feng Yang",
        "Hao Qin",
        "Zhangyuan Chen"
      ],
      "year": 2026,
      "venue": "Photonics",
      "venue_abbr": "Photonics",
      "rank_label": "未匹配 CIE 2023",
      "keywords": [
        "transient temperature prediction",
        "CNN-LSTM",
        "thermal management",
        "high-speed optical links",
        "thermal coupling",
        "real-time temperature prediction"
      ],
      "url": "https://doi.org/10.3390/photonics13111048",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/a604ab5b-1029-4de6-8153-a87afdbcc2be.html",
      "summary": "该研究提出面向光互连模块的集总参数热模型（LPTM），并以其生成的数据训练CNN-LSTM进行瞬态温度预测。对照COMSOL仿真，LPTM对关键部件瞬态温度的平均MAE为0.52 °C、平均RMSE为0.69 °C；CNN-LSTM在COMSOL生成的独立测试集上取得MAE 0.34 °C、RMSE 0.78 °C。上述结果属于仿真验证。",
      "summary_basis": "本站解读 · abstract-only"
    },
