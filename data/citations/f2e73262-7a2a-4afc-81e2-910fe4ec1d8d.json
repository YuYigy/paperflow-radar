      "id": "W7225018818",
      "doi": "10.1515/joc-2026-0448",
      "title": "Adaptive conformal finite-blocklength link adaptation for burst-mode coherent passive optical networks",
      "authors": [
        "Keshav Kumar",
        "Mohit Kumar Srivastava",
        "Man Mohan Shukla",
        "Vivek Kumar",
        "Gaurav Sahu"
      ],
      "year": 2026,
      "venue": "Journal of Optical Communications",
      "venue_abbr": "J. Opt. Commun.",
      "rank_label": "未匹配 CIE 2023",
      "keywords": [
        "coherent passive optical networks",
        "burst transmission",
        "link adaptation",
        "finite blocklength",
        "modulation format selection",
        "adaptive modulation and coding",
        "block error rate",
        "spectral efficiency",
        "optical line terminal",
        "channel estimation"
      ],
      "url": "https://doi.org/10.1515/joc-2026-0448",
      "cited_by_count": 0,
      "importance": 1,
      "score_basis": {},
      "role": "root",
      "reading_url": "items/f2e73262-7a2a-4afc-81e2-910fe4ec1d8d.html",
      "summary": "论文提出AC-FBLA方案：光线路终端根据近期残差估计构建随上下文变化、按时近程度加权的突发信噪比单侧下界，并结合误覆盖反馈和有限码长可行性筛选，选择发射功率、调制格式及编码率。摘要报告，在32个ONU、25 GBd、1024符号载荷等蒙特卡洛仿真条件下，覆盖率为97.67%–97.77%，低于98%的目标；相较点估计自适应，块错误率降低87.3%–97.8%。摘要另报告频谱效率提升45.3%–79.6%，但未明确该指标的比较基线。",
      "summary_basis": "本站解读 · abstract-only"
    },
